# =============================================================================
# BoviTrans — Variables de entorno (plantilla)
# Copiar a `.env` y ajustar.  NUNCA versionar el `.env` real.
# =============================================================================

# --- Base de datos (PostgreSQL) ---
POSTGRES_USER=bovitrans
POSTGRES_PASSWORD=bovitrans
POSTGRES_DB=bovitrans
DB_PORT=5432

# --- Aplicación (Next.js) ---
APP_PORT=3000

# Cadena de conexión que usa la app dentro de la red de Docker.
# El host "db" es el nombre del servicio en docker-compose.
DATABASE_URL=postgres://bovitrans:bovitrans@db:5432/bovitrans

# Secreto para firmar sesiones/JWT. Generar uno propio en producción:
#   openssl rand -base64 32
AUTH_SECRET=change-me-in-production
